<?xml version="1.0"?>
<ruleset name="Calidad Apuntado"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>
    Reporte informativo para la seccion 4.2 del Entregable 3: Ley de Demeter,
    acoplamiento entre objetos y complejidad. No rompe el build; el umbral que
    si bloquea (CC &lt;= 10) lo aplica Checkstyle.
  </description>
  <rule ref="category/java/design.xml/LawOfDemeter"/>
  <rule ref="category/java/design.xml/CouplingBetweenObjects"/>
  <rule ref="category/java/design.xml/CyclomaticComplexity">
    <properties>
      <property name="methodReportLevel" value="5"/>
      <property name="classReportLevel" value="40"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/CognitiveComplexity"/>
  <rule ref="category/java/errorprone.xml/EmptyCatchBlock"/>
  <rule ref="category/java/bestpractices.xml/SystemPrintln"/>
  <rule ref="category/java/bestpractices.xml/AvoidPrintStackTrace"/>
</ruleset>
